<div class="t20cal-mini">
  {{#if collapsed}}
    <button type="button" class="t20cal-mini__tab" data-action="toggleCollapse" title="Abrir Calendário de Arton">
      <i class="fa-solid fa-calendar-days"></i>
    </button>
  {{else}}
    <div class="t20cal-mini__panel">
      <div class="t20cal-mini__header">
        <span><i class="fa-solid fa-calendar-days"></i> Calendário de Arton</span>
        <a class="t20cal-mini__close" data-action="toggleCollapse" title="Recolher"><i class="fa-solid fa-xmark"></i></a>
      </div>

      <button type="button" class="t20cal-mini__date" data-action="openCalendar" title="Abrir calendário completo">
        <span class="t20cal-mini__date-label">{{dateLabel}}</span>
        <span class="t20cal-mini__time-label">{{timeLabel}}</span>
      </button>

      <div class="t20cal-mini__info">
        <span>Ano {{date.year}} — {{nimbCount}} Dias de Nimb este ano</span>
        {{#if date.moon}}
          <span title="Vitália: dia {{date.moon.dayInPhase}}/{{date.moon.phaseLength}}">🌙 Vitália em {{date.moon.name}}</span>
        {{/if}}
      </div>

      {{#if isGM}}
        <div class="t20cal-mini__controls">
          <button type="button" data-action="advance" data-amount="-3600" title="Retroceder 1 hora"><i class="fa-solid fa-backward"></i> 1h</button>
          <button type="button" data-action="advance" data-amount="3600" title="Avançar 1 hora">1h <i class="fa-solid fa-forward"></i></button>
          <button type="button" data-action="advance" data-amount="86400" title="Avançar 1 dia">1d <i class="fa-solid fa-forward-step"></i></button>
        </div>
      {{/if}}
    </div>
  {{/if}}
</div>
